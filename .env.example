# Copy to ".env" (git-ignored) and fill in real values. Compose reads ".env" automatically.
#   Copy-Item .env.example .env
# Never commit ".env".

# Password for the SQL Server "sa" account inside the container. Used only by the
# SQL Server container itself, the one-shot migrator and the one-shot grants job.
# SQL Server requires 8+ characters from at least 3 of: upper, lower, digit, symbol.
# Wrap it in SINGLE quotes so Compose treats $, # and ; literally. Do not use a
# single quote, double quote or backslash in it.
MSSQL_SA_PASSWORD='change-me-to-a-long-random-value'

# Password for "inventory_app", the low-privilege login the API itself uses
# (data read/write only, no schema changes). Letters, digits, "_" and "-" only.
INVENTORY_APP_PASSWORD=change-me-too-letters-digits-only

# Production (default): no seeding. Development + INVENTORY_SEED_ENABLED=true: inserts the
# demo products 900001-900003 (insert-only, never overwrites existing quantities).
ASPNETCORE_ENVIRONMENT=Production
INVENTORY_SEED_ENABLED=false

# Host port for the gRPC API (bound to 127.0.0.1 only).
INVENTORY_HOST_PORT=5275
