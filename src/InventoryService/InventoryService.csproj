<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2011e0be-6e33-477f-99da-5ecf9b13585e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- "Both" generates the client stub alongside the server base. The server is what this
         project serves; the client is what the integration tests use to call it over a real
         channel. Generating it once here keeps a single copy of the message types - generating
         them again in the test project made every shared type ambiguous (CS0436). -->
    <Protobuf Include="Protos\inventory.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.64.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Microsoft.Data.SqlClient (via EF Core's SQL Server provider) pins
      System.Security.Cryptography.Pkcs 9.0.11, which is affected by CVE-2026-84008 (high,
      GHSA-846f-f764-76mx) and CVE-2026-70162 (moderate, GHSA-2fmv-rv2c-59x7). Both are fixed
      in 10.0.13; the 9.x line is only patched in 9.0.21. Upgrading EF Core does not help -
      SqlClient 6.1.7 still pins 9.0.11 - so this direct reference is what lifts the resolved
      version. Being higher than the shared framework's copy, it is also deployed with the app,
      which patches the app even on a runtime older than 10.0.13.
      Remove once SqlClient's own dependency moves past the patched version.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
